# Dependencies
node_modules/
server/node_modules/

# Build output
dist/
build/
coverage/

# SQLite database
server/data/*.db
server/data/*.db-wal
server/data/*.db-shm
server/data/.write-probe.txt

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Environment
.env
.env.local

# Logs
*.log
npm-debug.log*
logs/

# Docs (local only — product/API/perf notes, interview prep, resume drafts)
# 注意用 docs/* 而非 docs/：父目录被整体排除后，git 不会递归进去，
# 下面的 ! 重新包含规则将失效。
docs/*
# 例外：技术设计文档公开留档
!docs/superpowers/

# Generated
src/components.d.ts

# Generated test data (run scripts/gen-test-data.mjs to regenerate)
test-data-*.json

# Misc
*.tsbuildinfo

# 部署文档(本地保留,不进仓库)
DEPLOY.md
